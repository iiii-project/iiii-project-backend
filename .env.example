DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5176
CSRF_TRUSTED_ORIGINS=http://localhost:5176

# 純本機 `manage.py runserver` 開發用這組值即可（指向你自己跑的 OpenAI 相容端點，
# 例如 LM Studio / Ollama / llama.cpp，或直接填 OpenAI 官方端點）。
# 用 docker compose 時，compose.yaml 會自動把 LLM_BASE_URL 覆蓋成 http://llama:1234/v1，
# 這裡的值不會被用到，不需要為 Docker 場景另外改。
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=
LLM_MODEL=local-model
LLM_TIMEOUT_SECONDS=120

# 抽籤完成後背景預先呼叫解籤，讓使用者擲筊/看過場的時間拿來等 LLM。
INTERPRET_PREWARM_ENABLED=True
INTERPRET_PREWARM_WORKERS=2

# 只有用 docker compose 一起啟動 llama.cpp 時才會用到；純本機開發可忽略。
LLAMA_MODEL=
LLAMA_MODEL_ALIAS=local-model

# Opik 是可選的 LLM 呼叫追蹤/觀測服務（comet-ml 的 opik SDK 直接讀這幾個變數，
# 不是本專案程式碼讀的）。不想串接就設 OPIK_ENABLED=False，其他三個可以留空。
OPIK_ENABLED=False
OPIK_URL_OVERRIDE=
OPIK_PROJECT_NAME=ai-fortune
OPIK_WORKSPACE=default
