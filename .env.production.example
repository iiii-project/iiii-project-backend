# 生產環境用的 .env 範本。複製成 .env 後把下面每一項換成真實值,不要沿用範例值。
# 這個檔案本身放範例值即可進版控;複製出來的 .env 絕對不要進版控。

# 用「python -c "import secrets; print(secrets.token_urlsafe(50))"」產生,
# 不要用 .env.example 裡開發用的預設值。
DJANGO_SECRET_KEY=change-me-to-a-real-random-secret

DJANGO_DEBUG=False

# 換成你實際的網域。務必保留 localhost —— healthcheck 是容器內部直接打
# http://localhost:8000/,沒有 localhost 會一直判定 unhealthy。
DJANGO_ALLOWED_HOSTS=fortune.example.org,localhost
CORS_ALLOWED_ORIGINS=https://fortune.example.org
CSRF_TRUSTED_ORIGINS=https://fortune.example.org

# nginx 已經處理 http -> https 導向時維持 False;如果前面的反向代理不是本專案
# 附的 nginx、沒做導向,才需要打開。
DJANGO_SECURE_SSL_REDIRECT=False

# 外部 LLM API(OpenAI / Azure OpenAI / 其他 OpenAI 相容端點),不要指向 llama
# 容器 —— 生產環境不跑本機 llama.cpp。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120

INTERPRET_PREWARM_ENABLED=True
INTERPRET_PREWARM_WORKERS=2

# 只有真的要開多個 backend 容器/replica 分攤流量或做高可用時才需要填,
# 例如 redis://<redis-host>:6379/0。單一台 VM、單一個 backend 容器時留空即可
# (會自動退回 InMemoryChannelLayer)。
REDIS_URL=

# 建議「不要」在容器啟動時自動建立管理員 —— 改成 up 之後手動跑一次：
#   docker compose exec backend python manage.py createsuperuser
# 真的想在啟動時自動建立,才需要把下面打開,並確保密碼是你自己設的強密碼。
DJANGO_CREATE_SUPERUSER=False
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password

OPIK_ENABLED=False
OPIK_URL_OVERRIDE=
OPIK_PROJECT_NAME=ai-fortune
OPIK_WORKSPACE=default
